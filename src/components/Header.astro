---
import { Icon } from "astro-icon/components";
---

<header
    class="fixed top-0 inset-x-0 z-50 px-8 py-5 backdrop-blur-xl bg-surface/80 max-sm:px-5 max-sm:py-4"
>
    <nav class="max-w-[640px] mx-auto flex justify-between items-center">
        <span
            class="text-lg font-semibold text-foreground tracking-tight select-none transition-colors duration-300"
        >
            ic.
        </span>
        <button
            id="theme-toggle"
            title="Toggle theme"
            aria-label="Toggle light and dark theme"
            class="flex items-center justify-center size-9 border border-outline rounded-[10px] bg-surface-alt text-muted cursor-pointer transition-all duration-300 hover:text-foreground hover:border-subtle hover:scale-105 active:scale-95"
        >
            <Icon name="tabler:sun" class="hidden dark:block" size={18} />
            <Icon name="tabler:moon" class="block dark:hidden" size={18} />
        </button>
    </nav>
</header>

<script>
    const toggle = document.getElementById("theme-toggle");

    toggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
    });
</script>
